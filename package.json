{
  "name": "bug-killer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit && pnpm lint && node --test test/*.test.ts",
    "lint": "oxlint src test && ritmo-devtools lint src/sim/lint.ts",
    "serve": "node src/server/main.ts"
  },
  "dependencies": {
    "@typeonce/ritmo": "^0.12.0",
    "@typeonce/ritmo-browser": "^0.12.0",
    "@typeonce/ritmo-math": "^0.12.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@typeonce/oxlint-plugin-ritmo": "0.12.0",
    "@typeonce/ritmo-devtools": "0.12.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
